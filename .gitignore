# ============================================================================
#  GYM 2.0 — политика .gitignore
#  Правило: «всё запрещено, разрешено только нужное».
#
#  ВАЖНО (ограничение git): чтобы реинклюдить файл внутри вложенной папки,
#  нужно ЯВНО разрешить каждый каталог-предок по цепочке от корня.
#  Поэтому все !dir/ и !dir/** идут в порядке «от корня к файлам»,
#  глобальные разрешения расширений — после, а запреты мусора — в самом конце.
# ============================================================================

# ---------------------------------------------------------------------------
# 1) ВСЁ ЗАПРЕЩЕНО ПО УМОЛЧАНИЮ (deny-all)
# ---------------------------------------------------------------------------
*

# ---------------------------------------------------------------------------
# 2) Разрешение структуры проекта: каталоги по цепочке от корня
# ---------------------------------------------------------------------------
# Корень
!Gym/
!Gym/Gym/
!Gym/frontend/

# --- Приложение webGym: подкаталоги -------------------
!Gym/Gym/webGym/
!Gym/Gym/webGym/API/
!Gym/Gym/webGym/API/v1/
!Gym/Gym/webGym/API/v1/*
!Gym/Gym/webGym/API/v1/**
!Gym/Gym/webGym/migrations/
!Gym/Gym/webGym/migrations/**
!Gym/Gym/webGym/static/
!Gym/Gym/webGym/static/css/
!Gym/Gym/webGym/static/css/**
!Gym/Gym/webGym/static/js/
!Gym/Gym/webGym/static/js/**
!Gym/Gym/webGym/static/img/
!Gym/Gym/webGym/static/img/**
!Gym/Gym/webGym/static/font/
!Gym/Gym/webGym/static/font/**
!Gym/Gym/webGym/static/fonts/
!Gym/Gym/webGym/static/fonts/**
!Gym/Gym/webGym/static/webfonts/
!Gym/Gym/webGym/static/webfonts/**

# --- Шаблоны Django -------------------------
!Gym/Gym/templates/
!Gym/Gym/templates/webGym/
!Gym/Gym/templates/webGym/**

# --- Фронтенд Vue: исходники и конфиги -------------------------
!Gym/frontend/public/
!Gym/frontend/public/**
!Gym/frontend/src/
!Gym/frontend/src/**
!Gym/frontend/package.json
!Gym/frontend/package-lock.json
!Gym/frontend/vue.config.js
!Gym/frontend/babel.config.js
!Gym/frontend/jsconfig.json
!Gym/frontend/README.md
!Gym/frontend/axios.js
!Gym/frontend/*.js

# --- Системные файлы репозитория -------------------------
!.gitignore
!ReadMe
!requirements.txt
!main.py

# ---------------------------------------------------------------------------
# 3) Глобальные разрешения по типу файла (после разрешения каталогов)
# ---------------------------------------------------------------------------
# Исходный код Python
!*.py
# Статические ассеты приложения
!*.css
!*.js
!*.map
!*.png
!*.jpg
!*.jpeg
!*.webp
!*.gif
!*.svg
!*.ico
!*.woff
!*.woff2
!*.ttf
!*.eot
# Шаблоны и конфиги
!*.html
!*.json
!*.md
!*.txt

# ============================================================================
# 4) ЗАПРЕЩЁННЫЕ КАТЕГОРИИ (в конце — побеждают разрешения выше)
# ============================================================================

# --- Виртуальные окружения и кэш менеджеров пакетов --------------------------
**/.venv/**
**/venv/**
**/env/**
**/site-packages/**
**/*.dist-info/**
**/.pypi/**
**/__pypackages__/**

# --- Зависимости node / собранные артефакты фронтенда ------------------------
**/node_modules/**
**/dist/**
**/build/**
**/*.egg-info/**

# --- Кэш Python / байткод ------------------------------------------------
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytype/**
**/.mypy_cache/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.coverage
**/.hypothesis/**

# --- Базы данных и логи ---------------------------------------------------
**/*.sqlite3
**/*.sqlite
**/*.db
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.swp
**/*.swo
**/*.*~
**/.DS_Store
**/Thumbs.db

# --- Временные/локальные артефакты в корне (скриншоты, дампы) ---------------
/_screenshot*.png
/_shot_*.png

# --- IDE/редакторы ---------------------------------------------------------
**/.idea/**
**/.vscode/**
**/*.iml

# --- Системная сгенерированная статика (collectstatic) ---------------------
# Admin-статика и результат collectstatic собираются на месте, не коммитим
!Gym/Gym/Gym/static/**
**/collectstatic/**